# ─────────────────────────────────────────────────────────────
#  Galaxy Health — variáveis de ambiente
#  Copie este arquivo para .env e preencha.
# ─────────────────────────────────────────────────────────────

# 1) Banco. Deixe "pglite" para rodar localmente sem conta nenhuma
#    (Postgres embutido em ./.pglite). Para publicar, use um projeto Neon
#    NOVO — não o do galaxy-cards. Ver SETUP.md passo 1.
DATABASE_URL="pglite"

# 2) Código de acesso. Gere as duas linhas abaixo com:
#       npm run passcode -- "seu-codigo-secreto"
PASSCODE_HASH=""
SESSION_SECRET=""

# Porta da API em desenvolvimento
PORT=3001
